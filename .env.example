# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# VITE_GEMINI_API_KEY: Used by the AI Crop Doctor (src/services/geminiService.ts)
# to call Gemini Vision directly from the browser for real leaf-photo diagnosis.
# Get a free key at https://aistudio.google.com/apikey
# NOTE: Vite bundles VITE_-prefixed vars into the client JS, so this key is
# visible to anyone inspecting the app. Fine for a demo/prototype; before a
# real production launch, move this call behind a small backend proxy instead.
VITE_GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
